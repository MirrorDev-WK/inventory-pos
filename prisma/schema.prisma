generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum StockMovementType {
  SALE
  VOID
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCK_COUNT
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  passwordHash   String
  role           Role              @default(CASHIER)
  active         Boolean           @default(true)
  sales          Sale[]            @relation("CashierSales")
  movements      StockMovement[]   @relation("MovementCreator")
  adjustments    InventoryAdjustment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model StoreSettings {
  id             String   @id @default("default-store")
  name           String
  address        String
  taxId          String
  receiptFooter  String?
  vatRate        Decimal  @default(0.07) @db.Decimal(5, 4)
  updatedAt      DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id              String          @id @default(cuid())
  sku             String          @unique
  barcode         String?         @unique
  name            String
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  costPrice       Decimal         @db.Decimal(12, 2)
  sellingPrice    Decimal         @db.Decimal(12, 2)
  stockOnHand     Int             @default(0)
  reorderLevel    Int             @default(5)
  archivedAt      DateTime?
  saleItems       SaleItem[]
  movements       StockMovement[]
  adjustments     InventoryAdjustment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Sale {
  id              String          @id @default(cuid())
  receiptNumber   String          @unique
  cashierId       String
  cashier         User            @relation("CashierSales", fields: [cashierId], references: [id])
  status          SaleStatus      @default(COMPLETED)
  paymentMethod   PaymentMethod
  subtotal        Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  discountReason  String?
  vatAmount       Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  cashReceived    Decimal?        @db.Decimal(12, 2)
  changeGiven     Decimal?        @db.Decimal(12, 2)
  voidReason      String?
  voidedAt        DateTime?
  items           SaleItem[]
  movements       StockMovement[]
  createdAt       DateTime        @default(now())
}

model SaleItem {
  id              String    @id @default(cuid())
  saleId          String
  sale            Sale      @relation(fields: [saleId], references: [id])
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  productName      String
  quantity         Int
  unitPrice        Decimal   @db.Decimal(12, 2)
  unitCost         Decimal   @db.Decimal(12, 2)
  discountAmount   Decimal   @default(0) @db.Decimal(12, 2)
  vatAmount        Decimal   @db.Decimal(12, 2)
  lineTotal        Decimal   @db.Decimal(12, 2)
}

model InventoryAdjustment {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  createdById   String
  type          StockMovementType
  quantity      Int
  reason        String
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
}

model ReceiptCounter {
  date          String   @id
  nextNumber    Int      @default(1)
  updatedAt     DateTime @updatedAt
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  saleId        String?
  sale          Sale?             @relation(fields: [saleId], references: [id])
  type          StockMovementType
  quantityDelta Int
  reason        String?
  createdById   String
  createdBy     User              @relation("MovementCreator", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
}
